# Copier ce fichier en ".env" à la racine du projet sur la VM, puis remplacer TOUTES les valeurs.
# Ne JAMAIS commiter le vrai fichier .env.

# --- S3 (RustFS) ---
S3_ACCESS_KEY=changez-moi-access
S3_SECRET_KEY=changez-moi-secret-long
S3_BUCKET=transactions

# --- PostgreSQL ---
POSTGRES_USER=pipeline
POSTGRES_PASSWORD=changez-moi-mot-de-passe
POSTGRES_DB=pipeline

# --- Application ---
# Image publiée par le workflow CD (remplacer <proprietaire>/<depot> en minuscules)
APP_IMAGE=ghcr.io/<proprietaire>/<depot>:latest
# Fréquence du planificateur (minutes)
SCHEDULE_MINUTES=5
